<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent for condenser-probe: one round every 15 minutes.

  Copy to ~/Library/LaunchAgents/com.condenser.probe.plist, replace the two
  /PATH/TO paths (and the uv location if it is not in /opt/homebrew/bin), then:
    launchctl load ~/Library/LaunchAgents/com.condenser.probe.plist

  RunAtLoad fires a round on login; StartCalendarInterval with four entries
  fires at :00/:15/:30/:45. Firings missed while the Mac sleeps coalesce into
  one catch-up round at wake, which the probe needs nothing extra to handle.
  (Deliberately NOT StartInterval: its timer can get pended across a sleep
  cycle and never fire again — observed 2026-07-26, runs=1 with a stuck
  "pended nondemand spawn = interval" while the Mac was awake for hours.)
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.condenser.probe</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/uv</string>
        <string>run</string>
        <string>condenser-probe</string>
        <string>run</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/PATH/TO/condenser/probe</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- bird needs a PATH that contains node/bird -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>0</integer></dict>
        <dict><key>Minute</key><integer>15</integer></dict>
        <dict><key>Minute</key><integer>30</integer></dict>
        <dict><key>Minute</key><integer>45</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/PATH/TO/Library/Logs/condenser-probe.log</string>
    <key>StandardErrorPath</key>
    <string>/PATH/TO/Library/Logs/condenser-probe.log</string>
</dict>
</plist>
