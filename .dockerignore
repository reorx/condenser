# Build context = the condenser/ dir; the Dockerfile needs pyproject.toml,
# uv.lock, the condenser/ package and the frontend/ sources. Keep everything
# else out of the context.
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.git/
.firecrawl/

# Frontend sources are built inside the image; local artifacts stay out.
frontend/node_modules/
frontend/dist/

# Local-only artifacts
tmp/
*.db
*.db-journal
.env
condenser_entity_cache.json
