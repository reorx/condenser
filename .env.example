# Telegram API credentials (https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# App gate: single password for the web UI (D8)
CONDENSER_APP_PASSWORD=

# Secret for cookie signing + StringSession encryption — use a long random string
CONDENSER_SECRET_KEY=

# SQLite path (mounted to a volume in Docker)
CONDENSER_DB_PATH=/data/condenser.db

# Backfill window in days when subscribing (default 7)
CONDENSER_BACKFILL_DAYS=7

# X (Twitter) source. The data is pushed in by the local probe (see probe/README.md),
# which authenticates with a device token — the server itself never talks to X.
# Master switch: false refuses subscribes/pushes and empties probe-config.
# CONDENSER_X_ENABLED=true
# Default tweets fetched per round, per feed kind (a subscription can override it).
# For You re-samples on every call — it is not a stable window — so HOME_COUNT times
# the probe's cadence is the archive growth rate. 20 per hour ≈ 480 tweets/day.
# CONDENSER_X_HOME_COUNT=20
# CONDENSER_X_USER_COUNT=10

# Embeddings, for the For You verdict (condenser/embedding.py). Any OpenAI-compatible
# endpoint works; the default points at DashScope's. WITHOUT AN API KEY THE WHOLE
# VERDICT PIPELINE STAYS INERT — nothing is embedded and no verdict is written, which
# is a perfectly fine way to run the X source.
# CONDENSER_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# CONDENSER_EMBEDDING_API_KEY=sk-...
# CONDENSER_EMBEDDING_MODEL=text-embedding-v4
# 64..2048 for text-embedding-v4. 256 keeps a year of For You inside a few hundred MB
# of the single SQLite file; raising it multiplies that.
# CONDENSER_EMBEDDING_DIMENSIONS=256
# Unlabeled vectors expire (they are used once and re-derivable from the tweet text);
# labeled ones are the training set and are never pruned. 0 disables pruning.
# CONDENSER_EMBEDDING_RETENTION_DAYS=90

# For You verdict (condenser/verdict.py). Every default here is deliberately cautious:
# the classifier says "neutral" unless it has real evidence, and it never hides anything.
# CONDENSER_VERDICT_ENABLED=true
# Cold-start gate: below this many labels of each polarity, nothing is judged *and*
# nothing is embedded — a fresh install spends nothing until you have taught it something.
# CONDENSER_VERDICT_MIN_POSITIVE=20
# CONDENSER_VERDICT_MIN_NEGATIVE=20
# kNN + the out-of-domain gate. Measured reference (text-embedding-v4@256): two tweets
# on the same topic in different languages sit at distance ~0.18, unrelated ones ~0.80.
# CONDENSER_VERDICT_K=15
# CONDENSER_VERDICT_MAX_DISTANCE=0.6
# CONDENSER_VERDICT_MIN_NEIGHBORS=3
# Asymmetric on purpose: a wrong "recommended" costs a glance, a wrong "not for you"
# costs the tweet — so negative needs a stronger score plus a second down neighbour.
# Both numbers were settled by a leave-one-out backtest on real labels (2026-07-27):
# +0.25 was 100% precise, and no negative setting beat guessing, which is why the
# negative side ships **off**. Turn it on only after your own sweep says otherwise.
# CONDENSER_VERDICT_POSITIVE_SCORE=0.25
# CONDENSER_VERDICT_NEGATIVE_ENABLED=false
# CONDENSER_VERDICT_NEGATIVE_SCORE=-0.55
# CONDENSER_VERDICT_MIN_DOWN_NEIGHBORS=2
# CONDENSER_VERDICT_WINDOW_HOURS=48
# CONDENSER_VERDICT_BATCH=100

# Attribute extraction (condenser/attributes.py) — the LLM that describes each tweet's
# topics and style for the future channel C. This is the only per-item **billed**
# component in the project, so it needs its own key: it stays completely inert until
# you set one, even though it is otherwise enabled. Same OpenAI-compatible shape as the
# embeddings above; qwen-flash costs roughly $0.01/day at ~400 tweets. The per-round
# batch is the spend ceiling, and /api/x/status reports how many tweets are described.
# CONDENSER_ATTR_API_KEY=
# CONDENSER_ATTR_ENABLED=true
# CONDENSER_ATTR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# CONDENSER_ATTR_MODEL=qwen-flash
# CONDENSER_ATTR_BATCH=40
# CONDENSER_ATTR_CONCURRENCY=4

# Link-preview fetching (condenser/preview.py). All optional; sensible defaults apply.
# CONDENSER_PREVIEW_FETCH_TIMEOUT=8
# CONDENSER_PREVIEW_CACHE_TTL=604800
# CONDENSER_PREVIEW_MAX_URLS=8
# Proxy preview thumbnails through the backend (true) or load them directly from the
# origin via a redirect (false). Set false to disable the image proxy.
# CONDENSER_PREVIEW_IMAGE_PROXY=true
